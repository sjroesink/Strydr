{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Ors": {
    "BaseUrl": "https://api.openrouteservice.org/",
    "ApiKey": "",
    "SupportsGreen": true,
    "Concurrency": 3,
    "AttemptTimeoutSeconds": 10,
    "RetryCount": 2,
    "DirectionsPerMinute": 35,
    "GeocodingPerMinute": 90,
    "SnapsPerMinute": 90
  },
  "Geocoding": { "Provider": "Ors" },
  "Photon": { "BaseUrl": "http://localhost:2322/", "Language": "" },
  "MapData": { "Path": "" },
  "Generation": {
    "MaxDistanceKm": 60,
    "SnapRadiusM": 1000,
    "SnapWarningM": 200,
    "DistanceTolerance": 0.05,
    "DeadlineSeconds": 45,
    "CacheTtlMinutes": 30
  },
  "RateLimiting": { "GeneratePerMinute": 3, "ConcurrentGenerations": 2, "GeocodePerMinute": 60, "PreviewPerMinute": 30 },
  "ResultStorage": { "DatabasePath": "data/meander.sqlite" },
  "Woodland": { "Url": "https://overpass-api.de/api/interpreter", "MaxSearchRadiusKm": 12, "TimeoutSeconds": 10, "CacheHours": 12 }
}
